, if you listed all schemes from “twint-issuer1” up to and including “twint-issuer39”."},{"type":"text","text":" "},{"type":"text","text":"The value is clamped between 0 and 39."}],"kind":"symbol","metadata":{"title":"maxIssuerNumber","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxIssuerNumber"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"modules":[{"name":"Plexy"}],"externalID":"s:5Plexy0A15ActionComponentC13ConfigurationV5TwintV15maxIssuerNumberSivp","symbolKind":"property","roleHeading":"Instance Property","role":"symbol"},"identifier":{"url":"doc:\/\/plexy.Plexy\/documentation\/Plexy\/PlexyActionComponent\/Configuration-swift.struct\/Twint-swift.struct\/maxIssuerNumber","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/plexy\/plexyactioncomponent\/configuration-swift.struct\/twint-swift.struct\/maxissuernumber"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://plexy.Plexy/documentation/Plexy/PlexyActionComponent/Configuration-swift.struct/Twint-swift.struct":{"role":"symbol","type":"topic","title":"PlexyActionComponent.Configuration.Twint","identifier":"doc:\/\/plexy.Plexy\/documentation\/Plexy\/PlexyActionComponent\/Configuration-swift.struct\/Twint-swift.struct","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Twint","kind":"identifier"}],"navigatorTitle":[{"text":"Twint","kind":"identifier"}],"url":"\/documentation\/plexy\/plexyactioncomponent\/configuration-swift.struct\/twint-swift.struct","abstract":[]},"doc://plexy.Plexy/documentation/Plexy":{"role":"collection","abstract":[],"identifier":"doc:\/\/plexy.Plexy\/documentation\/Plexy","kind":"symbol","title":"Plexy","url":"\/documentation\/plexy","type":"topic"},"doc://plexy.Plexy/documentation/Plexy/PlexyActionComponent/Configuration-swift.struct/Twint-swift.struct/maxIssuerNumber":{"url":"\/documentation\/plexy\/ple