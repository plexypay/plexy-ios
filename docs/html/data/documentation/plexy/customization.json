{"hierarchy":{"paths":[["doc:\/\/plexy.Plexy\/documentation\/Plexy"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/plexy.Plexy\/documentation\/Plexy\/Customization"},"abstract":[{"type":"text","text":"Both the Drop-in and the Components offer a number of customization options to allow you to match the appearance of your app."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","sections":[],"variants":[{"paths":["\/documentation\/plexy\/customization"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"Customization","roleHeading":"Article","role":"article","modules":[{"name":"Plexy"}]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Localization","type":"heading","text":"Localization","level":2},{"inlineContent":[{"type":"text","text":"To customize strings, see: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/plexy.Plexy\/documentation\/Plexy\/Localization"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Styling","type":"heading","text":"Styling","level":2},{"inlineContent":[{"text":"For example, to change the section header titles and form field titles in the Drop-in to red, and turn the submit button’s background to black with white foreground:","type":"text"}],"type":"paragraph"},{"tabs":[{"title":"Drop-in","content":[{"syntax":"swift","code":["var style = DropInComponent.Style()","style.listComponent.sectionHeader.title.color = .red","style.formComponent.textField.title.color = .red","style.formComponent.mainButtonItem.button.backgroundColor = .black","style.formComponent.mainButtonItem.button.title.color = .white","","let configuration = DropInComponent.Configuration(style: style)","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: configuration)"],"type":"codeListing"}]},{"title":"Components","content":[{"syntax":"swift","code":["var style = FormComponentStyle()","style.backgroundColor = .black","style.header.title.color = .white","style.textField.title.color = .white","style.textField.text.color = .white","style.switch.title.color = .white","","let config = CardComponent.Configuration(style: style)","let component = CardComponent(paymentMethod: paymentMethod,","                              context: context,","                              configuration: config)"],"type":"codeListing"}]}],"type":"tabNavigator"},{"anchor":"Custom-Payment-Method-Display-Information","type":"heading","text":"Custom Payment Method Display Information","level":2},{"inlineContent":[{"type":"text","text":"The following examples provide custom information to show for a specific payment method"}],"type":"paragraph"},{"tabs":[{"content":[{"type":"codeListing","syntax":"swift","code":["\/\/ Override the (regular) payment method of type `.scheme` with custom display information","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .scheme,","    with: .init(","        title: \"Custom Cards title\",","        subtitle: \"Custom Cards description\"","    )",")"]},{"type":"codeListing","syntax":"swift","code":["\/\/ Override the (regular) `.giftcard` payment method if the brand is \"genericgiftcard\"","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .giftcard,","    with: .init(","        title: \"Custom Giftcard title\",","        subtitle: \"Custom Giftcard subtitle\"","        ),","    where: { (paymentMethod: GiftCardPaymentMethod) -> Bool in","        paymentMethod.brand == \"genericgiftcard\"","    }",")"]},{"type":"paragraph","inlineContent":[{"text":"To override the display information for stored payment methods use:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["paymentMethods.overrideDisplayInformation(","    ofStoredPaymentMethod: ...",")"]}],"title":"Drop-in"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For components you can either set the "},{"type":"codeVoice","code":"merchantProvidedDisplayInformation"},{"text":" directly before creating the component or use the same approach as with ","type":"text"},{"inlineContent":[{"text":"Drop-In","type":"text"}],"type":"strong"},{"text":".","type":"text"}]},{"type":"codeListing","code":["cardPaymentMethod.merchantProvidedDisplayInformation = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"],"syntax":"swift"}],"title":"Components"}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"text":"For a full list of customization options can be found in the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/plexy.Plexy\/documentation\/Plexy\/API-Reference","type":"reference"},{"text":".","type":"text"}]}]}],"references":{"doc://plexy.Plexy/documentation/Plexy":{"role":"collection","abstract":[],"identifier":"doc:\/\/plexy.Plexy\/documentation\/Plexy","kind":"symbol","title":"Plexy","url":"\/documentation\/plexy","type":"topic"},"doc://plexy.Plexy/documentation/Plexy/Localization":{"role":"article","identifier":"doc:\/\/plexy.Plexy\/documentation\/Plexy\/Localization","title":"Localization","kind":"article","type":"topic","url":"\/documentation\/plexy\/localization","abstract":[{"text":"The SDK allows you to customize UI strings and manage locale behavior using the ","type":"text"},{"type":"codeVoice","code":"LocalizationParameters"},{"text":" object. You can configure these settings for both the Drop-in and individual Components through their ","type":"text"},{"type":"codeVoice","code":"configuration.localizationParameters"},{"text":" property.","type":"text"}]},"doc://plexy.Plexy/documentation/Plexy/API-Reference":{"type":"topic","url":"\/documentation\/plexy\/api-reference","identifier":"doc:\/\/plexy.Plexy\/documentation\/Plexy\/API-Reference","abstract":[{"type":"text","text":"The Plexy DropIn\/Components SDK API Reference."}],"kin